FROM node:22-alpine AS build
WORKDIR /app/rainy-corner-src
COPY rainy-corner-src/package.json rainy-corner-src/package-lock.json ./
RUN npm ci
COPY rainy-corner-src/ ./
ARG UMAMI_SCRIPT_URL=
ARG UMAMI_WEBSITE_ID=
ENV UMAMI_SCRIPT_URL=${UMAMI_SCRIPT_URL} UMAMI_WEBSITE_ID=${UMAMI_WEBSITE_ID}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/index.html /usr/share/nginx/html/index.html
COPY project.json /usr/share/nginx/html/project.json
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
